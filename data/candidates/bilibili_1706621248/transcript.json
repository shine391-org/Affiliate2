    {
      "start": 134.0,
      "end": 135.0,
      "text": "不急着炒"
    },
    {
      "start": 135.0,
      "end": 136.0,
      "text": "先来点油煎五花肉"
    },
    {
      "start": 136.0,
      "end": 138.0,
      "text": "中火不要着急"
    },
    {
      "start": 138.0,
      "end": 139.0,
      "text": "慢慢煎上色"
    },
    {
      "start": 139.0,
      "end": 140.0,
      "text": "让猪油炸出来"
    },
    {
      "start": 140.0,
      "end": 142.0,
