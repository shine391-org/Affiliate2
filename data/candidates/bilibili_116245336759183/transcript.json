      "start": 247.0,
      "end": 248.0,
      "text": "肯某幾口吃"
    },
    {
      "start": 248.0,
      "end": 249.0,
      "text": "但我進化了"
    },
    {
      "start": 249.0,
      "end": 251.0,
      "text": "新鮮的雞翅洗乾淨"
    },
    {
      "start": 251.0,
      "end": 252.0,
      "text": "擦乾水分"
    },
    {
      "start": 252.0,
      "end": 254.0,
      "text": "要很乾很乾的那種"
    },
    {
      "start": 254.0,
      "end": 255.0,
      "text": "最好把肉裡的"
    },
    {
      "start": 255.0,
      "end": 256.0,
      "text": "血水也給擠出來"
    },
    {
      "start": 256.0,
      "end": 257.0,
      "text": "確保乾爽"
    },
    {
      "start": 257.0,
      "end": 258.0,
      "text": "是最重要的一步"
    },
    {
      "start": 258.0,
      "end": 259.0,
      "text": "不要改花刀"
    },
    {
      "start": 259.0,
      "end": 260.0,
      "text": "也不要紮孔"
    },
    {
      "start": 260.0,
      "end": 262.0,
      "text": "調料只有二二糧醃料"
    },
    {
      "start": 262.0,
      "end": 263.0,
      "text": "全部塗抹均勻"
    },
    {
      "start": 263.0,
      "end": 264.0,
      "text": "冷藏醃漬"
    },
    {
      "start": 264.0,
      "end": 265.0,
      "text": "一個晚上入味"
    },
    {
      "start": 265.0,
      "end": 266.0,
      "text": "第二天"
    },
    {
      "start": 266.0,
      "end": 267.0,
      "text": "再拿空氣炸鍋烤"
    },
    {
      "start": 267.0,
      "end": 269.0,
      "text": "抹掉多餘的醬料"
    },
    {
      "start": 269.0,
      "end": 270.0,
      "text": "不要油脂"
    },
    {
      "start": 270.0,
      "end": 271.0,
      "text": "只用烤架"
    },
    {
      "start": 271.0,
      "end": 272.0,
      "text": "把雞翅抬高起來"
    },
    {
      "start": 272.0,
      "end": 273.0,
      "text": "160度"
    },
    {
      "start": 273.0,
      "end": 274.0,
      "text": "先烤10分鐘"
    },
    {
      "start": 274.0,
      "end": 276.0,
      "text": "然後翻面"
    },
    {
      "start": 276.0,
      "end": 277.0,
      "text": "還是160度"
    },
    {
      "start": 277.0,
      "end": 278.0,
      "text": "10分鐘"
    },
    {
      "start": 278.0,
      "end": 279.0,
      "text": "最後再翻回來"
    },
    {
      "start": 279.0,
      "end": 280.0,
      "text": "180度"
    },
    {
      "start": 280.0,
      "end": 281.0,
      "text": "10分鐘"
    },
    {
      "start": 281.0,
      "end": 282.0,
      "text": "就這樣"
    },
    {
      "start": 282.0,
      "end": 283.0,
      "text": "才能做出"
    },
    {
      "start": 283.0,
      "end": 284.0,
      "text": "皮皮脂薄的"
    },
    {
      "start": 284.0,
      "end": 285.0,
      "text": "玻璃脆雞翅"
    },
    {
      "start": 287.0,
      "end": 288.0,
      "text": "什麼都不用說了"
    },
    {
      "start": 288.0,
      "end": 289.0,
      "text": "聽著都好吃"
    },
    {
      "start": 289.0,
      "end": 290.0,
      "text": "而且還去除了"
    },
    {
      "start": 290.0,
      "end": 291.0,
      "text": "大多數的脂肪"
    },
    {
      "start": 291.0,
      "end": 293.0,
      "text": "出乎意料的健康"
    },
    {
      "start": 294.0,
      "end": 295.0,
      "text": "傳統的魚香肉絲"
    },
    {
      "start": 295.0,
      "end": 296.0,
      "text": "好吃"
    },
    {
      "start": 296.0,
      "end": 297.0,
      "text": "但不適合小孩"
    },
    {
      "start": 297.0,
      "end": 298.0,
      "text": "其實感覺酸甜款"
    },
    {
      "start": 298.0,
      "end": 299.0,
      "text": "也很不錯"
    },
    {
      "start": 299.0,
      "end": 300.0,
      "text": "主要就是"
    },
    {
      "start": 300.0,
      "end": 301.0,
      "text": "改一下醬汁"
    },
    {
      "start": 301.0,
      "end": 302.0,
      "text": "生抽"
    },
    {
      "start": 302.0,
      "end": 303.0,
      "text": "老抽"
    },
    {
      "start": 303.0,
      "end": 304.0,
      "text": "糖"
    },
    {
      "start": 304.0,
      "end": 305.0,
      "text": "味精"
    },
    {
      "start": 305.0,
      "end": 306.0,
      "text": "一點白胡椒"
    },
    {
      "start": 306.0,
      "end": 307.0,
      "text": "把豆瓣醬"
    },
    {
      "start": 307.0,
      "end": 308.0,
      "text": "換成番茄醬"
    },
    {
      "start": 308.0,
      "end": 309.0,
      "text": "再加澱粉和清水"
    },
    {
      "start": 309.0,
      "end": 310.0,
      "text": "攪拌均勻"
    },
    {
      "start": 311.0,
      "end": 312.0,
      "text": "配菜部分"
    },
    {
      "start": 312.0,
      "end": 313.0,
      "text": "除了標配的"
    },
    {
      "start": 313.0,
      "end": 314.0,
      "text": "胡蘿蔔和木耳絲"
    },
    {
      "start": 314.0,
      "end": 315.0,
      "text": "青椒一定要選甜椒"
    },
    {
      "start": 315.0,
      "end": 316.0,
      "text": "或者乾脆換成"
    },
    {
      "start": 316.0,
      "end": 317.0,
      "text": "不辣的窩筍"
    },
    {
      "start": 317.0,
      "end": 318.0,
      "text": "醃一下"
    },
    {
      "start": 318.0,
      "end": 319.0,
      "text": "不要用料酒"
    },
    {
      "start": 319.0,
      "end": 320.0,
      "text": "但甜味的米酒"
    },
    {
      "start": 320.0,
      "end": 321.0,
      "text": "會更加合適"
    },
    {
      "start": 321.0,
      "end": 322.0,
      "text": "和醬油"
    },
    {
      "start": 322.0,
      "end": 323.0,
      "text": "澱粉一起抓勻"
    },
    {
      "start": 324.0,
      "end": 325.0,
      "text": "起鍋燒油"
    },
    {
      "start": 325.0,
      "end": 326.0,
      "text": "大火"
    },
    {
      "start": 326.0,
      "end": 327.0,
      "text": "冷油狀態"
    },
    {
      "start": 327.0,
      "end": 328.0,
      "text": "直接下肉絲"
    },
    {
      "start": 328.0,
      "end": 329.0,
      "text": "心情滑散"
    },
    {
      "start": 329.0,
      "end": 330.0,
      "text": "炒到剛剛開始變色"
    },
    {
      "start": 330.0,
      "end": 331.0,
      "text": "就把配菜的"
    },
    {
      "start": 331.0,
      "end": 332.0,
      "text": "三絲放進去"
    },
    {
      "start": 332.0,
      "end": 334.0,
      "text": "把所有材料炒軟"
    },
    {
      "start": 335.0,
      "end": 336.0,
      "text": "再倒入醬汁"
    },
    {
      "start": 336.0,
      "end": 337.0,
      "text": "等它腱汁濃稠"
    },
    {
      "start": 337.0,
      "end": 338.0,
      "text": "就可以出鍋了"
    },
    {
      "start": 339.0,
      "end": 340.0,
      "text": "其實和魚香肉絲"
    },
    {
      "start": 340.0,
      "end": 341.0,
      "text": "也沒啥關係"
    },
    {
      "start": 341.0,
      "end": 342.0,
      "text": "但好吃就行"
    },
    {
      "start": 342.0,
      "end": 343.0,
      "text": "肉絲嫩"
    },
    {
      "start": 343.0,
      "end": 344.0,
      "text": "甜椒脆"
    },
    {
      "start": 344.0,
      "end": 345.0,
      "text": "加上割汁作響的木耳"
    },
    {
      "start": 345.0,
      "end": 346.0,
      "text": "拌著酸甜的湯汁"
    },
    {
      "start": 346.0,
      "end": 348.0,
      "text": "不怕孩子不下飯"
    },
    {
      "start": 349.0,
      "end": 350.0,
      "text": "做到這裡"
    },
    {
      "start": 350.0,
      "end": 351.0,
      "text": "不知道有沒有解決"
    },
    {
      "start": 351.0,
      "end": 352.0,
      "text": "你的煩惱"
    },
    {
      "start": 352.0,
      "end": 353.0,
      "text": "我應該是可以"
    },
    {
      "start": 353.0,
      "end": 354.0,
      "text": "給朋友交差了"
    },
    {
      "start": 354.0,
      "end": 355.0,
      "text": "要是不夠"
    },
    {
      "start": 355.0,
      "end": 356.0,
      "text": "我再琢磨琢磨"
    },
    {
      "start": 356.0,
      "end": 357.0,
      "text": "希望小朋友們"
    },
    {
      "start": 357.0,
      "end": 358.0,
      "text": "吃飯不痛苦"
    },
    {
      "start": 358.0,
      "end": 359.0,
      "text": "都有好胃口"
    },
    {
      "start": 359.0,
      "end": 360.0,
      "text": "我們下期再見"
