    },
    {
      "start": 67.0,
      "end": 68.0,
      "text": "全部翻炒均勻"
    },
    {
      "start": 68.0,
      "end": 70.0,
      "text": "重點來了"
    },
    {
      "start": 70.0,
      "end": 71.0,
      "text": "出鍋前撒上多多的"
    },
    {
