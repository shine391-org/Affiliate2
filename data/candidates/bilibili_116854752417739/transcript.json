    {
      "start": 206.4,
      "end": 207.4,
      "text": "但我真的好爱"
    },
    {
      "start": 207.4,
      "end": 209.4,
      "text": "苦的清新 脆的水润"
    },
    {
      "start": 209.4,
      "end": 211.0,
      "text": "正好现在食欲不振的夏天"
    },
    {
      "start": 211.0,
      "end": 212.4,
      "text": "吃起来刚刚好"
    },
    {
      "start": 213.8,
      "end": 216.0,
      "text": "无水蒸的几层逻辑很简单"
