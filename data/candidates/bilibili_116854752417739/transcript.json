    },
    {
      "start": 140.4,
      "end": 142.6,
      "text": "就能一键入手从款了"
    },
    {
      "start": 143.6,
      "end": 144.4,
      "text": "冷知识"
    },
    {
      "start": 144.4,
      "end": 146.0,
