    {
      "start": 529.0,
      "end": 530.0,
      "text": "麻醬"
    },
    {
      "start": 530.0,
      "end": 531.0,
      "text": "全部放下去"
    },
    {
      "start": 531.0,
      "end": 532.0,
      "text": "充分攪勻"
    },
    {
      "start": 532.0,
      "end": 533.0,
