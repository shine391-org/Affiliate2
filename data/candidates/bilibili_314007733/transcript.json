      "end": 566.0,
      "text": "需要的醬油"
    },
    {
      "start": 566.0,
      "end": 567.0,
      "text": "蠔油"
    },
    {
      "start": 567.0,
      "end": 568.0,
      "text": "白糖"
    },
    {
      "start": 568.0,
      "end": 569.0,
      "text": "黑鹽"
    },
    {
      "start": 569.0,
      "end": 570.0,
      "text": "醬燉在宴席中"
    },
    {
      "start": 570.0,
      "end": 571.0,
