    },
    {
      "start": 513.0,
      "end": 514.0,
      "text": "沒有技巧"
    },
    {
      "start": 514.0,
      "end": 516.0,
      "text": "選擇任意你喜歡的食材"
    },
    {
      "start": 516.0,
      "end": 517.0,
      "text": "比如說"
    },
    {
      "start": 517.0,
      "end": 518.0,
      "text": "土豆"
    },
    {
      "start": 518.0,
      "end": 520.0,
      "text": "除非你有肥牛之類"
    },
    {
      "start": 520.0,
      "end": 521.0,
