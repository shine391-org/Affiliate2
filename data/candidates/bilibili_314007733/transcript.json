    {
      "start": 686.0,
      "end": 688.0,
      "text": "恨著走一年"
    },
    {
      "start": 688.0,
      "end": 689.0,
      "text": "但我還是要說"
    },
    {
      "start": 689.0,
      "end": 691.0,
      "text": "做飯不是做實驗"
    },
    {
      "start": 691.0,
      "end": 692.0,
      "text": "多一點少一點"
    },
    {
      "start": 692.0,
      "end": 693.0,
      "text": "都不會爆炸"
    },
    {
      "start": 693.0,
      "end": 694.0,
      "text": "最準的標誌"
    },
    {
      "start": 694.0,
      "end": 696.0,
      "text": "永遠是自己的舌頭"
    },
    {
      "start": 696.0,
      "end": 698.0,
      "text": "多吃 多試 多犯錯"
