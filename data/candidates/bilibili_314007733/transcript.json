      "text": "你都可以放心的"
    },
    {
      "start": 484.0,
      "end": 486.0,
      "text": "交給這款白酌汁"
    },
    {
      "start": 487.0,
      "end": 488.0,
      "text": "第七道"
    },
    {
      "start": 488.0,
      "end": 489.0,
      "text": "我們來做"
    },
    {
