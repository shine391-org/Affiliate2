    {
      "start": 698.0,
      "end": 700.0,
      "text": "理解了適量少許"
    },
    {
      "start": 700.0,
      "end": 702.0,
      "text": "才算把握到了精髓"
    },
    {
      "start": 702.0,
      "end": 704.0,
      "text": "下次我們再來玩玩香腥料"
    },
    {
      "start": 704.0,
      "end": 705.0,
      "text": "蔥薑蒜 花椒大料"
    },
    {
      "start": 705.0,
      "end": 706.0,
      "text": "什麼時候用"
    },
    {
      "start": 706.0,
      "end": 707.0,
      "text": "怎麼用"
    },
    {
      "start": 707.0,
      "end": 709.0,
      "text": "感覺又可以老很久"
    },
    {
      "start": 709.0,
      "end": 710.0,
      "text": "最後感謝您的支持"
    },
    {
      "start": 710.0,
      "end": 712.0,
      "text": "我是愛吃又愛護農的小胖"
    },
    {
      "start": 712.0,
      "end": 714.0,
      "text": "我們下期不見 不散"
