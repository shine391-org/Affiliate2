    },
    {
      "start": 502.0,
      "end": 503.0,
      "text": "生抽"
    },
    {
      "start": 503.0,
      "end": 504.0,
      "text": "蠔油"
    },
    {
      "start": 504.0,
      "end": 505.0,
      "text": "砂糖"
    },
    {
      "start": 505.0,
      "end": 506.0,
      "text": "香醋"
    },
    {
      "start": 506.0,
      "end": 507.0,
      "text": "味精"
    },
    {
      "start": 507.0,
      "end": 508.0,
