    },
    {
      "start": 562.0,
      "end": 563.0,
      "text": "甜麵醬"
    },
    {
      "start": 563.0,
      "end": 564.0,
      "text": "豆瓣醬"
    },
    {
      "start": 564.0,
      "end": 565.0,
      "text": "另一碗放燉煮時"
    },
    {
