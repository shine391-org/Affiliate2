# Affiliate2 V1 environment template
# Copy this file to .env. All integrations are optional for basic local startup.

# === REQUIRED ===
# No secret or provider variable is required for the UI/API to start.
# Python 3.11, Node.js 22+, npm 10+, FFmpeg and ffprobe are external prerequisites.

# === APPLICATION (safe defaults) ===
DEBUG=false
HOST=127.0.0.1
PORT=16888
FRONTEND_URL=http://127.0.0.1:16888
# Leave blank on first run. Affiliate2 generates and persists both keys locally.
SECRET_KEY=
ENCRYPTION_KEY=
# Optional: put database, media, models and temporary output outside the release tree.
# VIRALMINT_DATA_DIR=C:\Affiliate2Data
# Optional advanced override used by legacy-compatible CLI paths.
# CONTENT_ENGINE_ROOT=C:\Affiliate2

# === LOCAL AI / CLOUD AI (OPTIONAL; configure one provider) ===
# Generic OpenAI-compatible endpoint. LM Studio example:
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=http://127.0.0.1:1234/v1
# AI_API_KEY=lm-studio
# AI_MODEL=your-loaded-model-id
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Direct SDK providers. Prefer configuring credentials in Settings when possible.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# === BROWSER / CDP (OPTIONAL; Douyin authenticated workflows only) ===
# Launch Edge with --remote-debugging-port=9222 and a dedicated --user-data-dir,
# sign in to Douyin there, then enable this endpoint.
AFFILIATE2_DOUYIN_CDP_URL=
# Legacy alias accepted by the backend when the Affiliate2-specific value is blank.
DOUYIN_CDP_URL=
# Optional Chrome/Edge executable for Motion Graphics browser rendering.
HYPERFRAMES_BROWSER_PATH=

# === MEDIA / FFMPEG ===
# FFmpeg and ffprobe are discovered from PATH; no variables are required.
# Set false for faster, softer Motion Graphics rendering.
MOTION_SUPERSAMPLE=true

# === HUGGING FACE / WHISPERX (OPTIONAL) ===
# Required only for WhisperX speaker diarization. Never commit a real token.
HUGGINGFACE_TOKEN=
# Optional model-cache relocation (Whisper/faster-whisper/WhisperX).
HF_HOME=

# === DISCOVERY / STOCK SERVICES (OPTIONAL) ===
YOUTUBE_API_KEY=
TIKHUB_API_KEY=
PEXELS_API_KEY=

# === PUBLISH OAUTH (OPTIONAL; human approval remains mandatory) ===
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:16888/api/settings/youtube-callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:16888/api/settings/tiktok-upload-callback
